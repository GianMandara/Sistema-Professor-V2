# Copie este arquivo para ".env" e ajuste os valores localmente.
# Nunca faça commit do arquivo ".env" real (ele já está no .gitignore).

SECRET_KEY=troque-por-uma-chave-aleatoria-segura
DATABASE_URL=
FERIADOS_API_URL=https://brasilapi.com.br/api/feriados/v1

# Criptografa dados pessoais em repouso (nome do professor, e-mail/telefone
# do aluno, observações da aula). Gere a sua com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️ Guarde uma cópia segura fora do .env (gerenciador de senhas, por
# exemplo) — se a chave for perdida, os dados criptografados ficam
# irrecuperáveis para sempre. Sem essa variável, os campos continuam
# funcionando, só sem a criptografia extra.
ENCRYPTION_KEY=

# Contas de professor agora são criadas pelo próprio sistema (tela de
# "Criar conta" na landing page) — não há mais usuário/senha fixos aqui.

# True somente em produção com HTTPS (ex.: Render). Em dev local por
# http://, deixe False — senão o navegador não guarda o cookie de sessão.
SESSION_COOKIE_SECURE=false

# E-mail de lembrete ao agendar uma aula. Sem MAIL_SERVER e MAIL_USERNAME
# preenchidos, o envio é pulado silenciosamente (agendar aula continua
# funcionando normalmente). Exemplo com Gmail: MAIL_SERVER=smtp.gmail.com,
# MAIL_PORT=587, MAIL_USE_TLS=true, MAIL_USERNAME=seu-email@gmail.com,
# MAIL_PASSWORD=senha de app (não a senha normal da conta).
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_REMETENTE=
