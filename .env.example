# Copie este arquivo para ".env" e ajuste os valores localmente.
# Nunca faça commit do arquivo ".env" real (ele já está no .gitignore).

SECRET_KEY=troque-por-uma-chave-aleatoria-segura
DATABASE_URL=
FERIADOS_API_URL=https://brasilapi.com.br/api/feriados/v1

# Login único do professor. Sem os dois preenchidos, ninguém consegue
# entrar no sistema (login fica desativado por padrão, "fail-closed").
LOGIN_USUARIO=
LOGIN_SENHA=

# True somente em produção com HTTPS (ex.: Render). Em dev local por
# http://, deixe False — senão o navegador não guarda o cookie de sessão.
SESSION_COOKIE_SECURE=false

# E-mail de lembrete ao agendar uma aula. Sem MAIL_SERVER e MAIL_USERNAME
# preenchidos, o envio é pulado silenciosamente (agendar aula continua
# funcionando normalmente). Exemplo com Gmail: MAIL_SERVER=smtp.gmail.com,
# MAIL_PORT=587, MAIL_USE_TLS=true, MAIL_USERNAME=seu-email@gmail.com,
# MAIL_PASSWORD=senha de app (não a senha normal da conta).
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_REMETENTE=
